': () => <Home />,\n  '/showblog/:id': ({id}) => <ShowBlog id={id} />,\n  '/about': () => <About />,\n};\n\nfunction App() {\n  const routeResult = useRoutes(routes);\n  return (\n    <div className=\"App\">\n      <Nav />\n      <div className=\"Container\">\n        {routeResult || <NotFound /> }\n      </div>\n      <Footer />\n    </div>\n  );\n}\n\nexport default App;\n","C:\\Users\\oussa\\Documents\\javascript\\NodeJs\\node-express\\Blog project\\blogs-app\\src\\redux\\store.js",[],"C:\\Users\\oussa\\Documents\\javascript\\NodeJs\\node-express\\Blog project\\blogs-app\\src\\partials\\footer.js",[],"C:\\Users\\oussa\\Documents\\javascript\\NodeJs\\node-express\\Blog project\\blogs-app\\src\\partials\\nav.js",["77"],"import \"../styles/style.css\";\r\nimport blogtech from \"../assets/img/blogtech.png\";\r\nimport {A} from 'hookrouter';\r\n\r\nconst Nav = () => {\r\n  return (\r\n    <div className=\"nav\">\r\n      <div className=\"site-title\">\r\n        <a href=\"/\">\r\n          <img className=\"navImg\" src={blogtech} />\r\n        </a>\r\n      </div>\r\n      <div className=\"navigation\">\r\n        <ul>\r\n          <li>\r\n            <A href=\"/\">Blogs</A>\r\n          </li>\r\n          <li>\r\n            <A href=\"/about\">About</A>\r\n          </li>\r\n          <li>\r\n            <A href=\"\">New Blog</A>\r\n          </li>\r\n        </ul>\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default Nav;\r\n","C:\\Users\\oussa\\Documents\\javascript\\NodeJs\\node-express\\Blog project\\blogs-app\\src\\component\\blog.js",["78","79"],"import '../styles/style.css';\r\nimport { useDispatch, useSelector } from 'react-redux'\r\nimport { useEffect } from 'react';\r\nimport { main } from '../redux/actions/blogAction';\r\n\r\nconst Blog = () => {\r\n  const dispatch = useDispatch()\r\n  useEffect(()=>{\r\n    dispatch(main());\r\n  },[]);\r\n  const blogs = useSelector((state) => state.Blogs.blogs);\r\n  return (\r\n    <>\r\n    <div className=\"content\">\r\n    {(blogs && blogs.length > 0) &&\r\n      blogs.map((blog)=>{\r\n        return(\r\n          <div className=\"blogShape\">\r\n            <div className=\"single\">\r\n              <a  href=\"\">\r\n                <div className=\"blogContentDisplay\">\r\n                  <div className=\"blogImage\"></div>\r\n                  <div className=\"blogDescription\">\r\n                    <h3 className=\"title\"><a href={`/showblog/${blog._id}`}>{blog.title}</a></h3>\r\n                    <p className=\"snippet\">\r\n                      {blog.snippet}\r\n                    </p>\r\n                  </div>\r\n                </div>\r\n              </a>\r\n            </div>\r\n          </div>\r\n        )\r\n      })\r\n    }\r\n    </div>\r\n    </>\r\n  );\r\n};\r\n\r\nexport default Blog;\r\n","C:\\Users\\oussa\\Documents\\javascript\\NodeJs\\node-express\\Blog project\\blogs-app\\src\\component\\about.js",[],"C:\\Users\\oussa\\Documents\\javascript\\NodeJs\\node-express\\Blog project\\blogs-app\\src\\component\\home.js",["80"],"\r\nimport Blog from './blog';\r\nimport Triangle from '../assets/svg/triangle';\r\nconst Home = () => {\r\n    return ( \r\n        <div className=\"home\">\r\n        <div className=\"HomeHeader\">\r\n            <div className=\"HomeHeaderChild1\">\r\n                <h1 className=\"blogName\">BlogTech</h1>\r\n                <div className=\"homeText\">\r\n                    <span>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor</span>\r\n                </div>\r\n            </div>\r\n            <div className=\"HomeHeaderChild2\">\r\n                <div className=\"HomeHeaderChild21\">\r\n                   {/* <Triangle className=\"TriangleShape\" /> */}\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <Blog />\r\n        </div>\r\n     );\r\n}\r\n \r\nexport default Home;","C:\\Users\\oussa\\Documents\\javascript\\NodeJs\\node-express\\Blog project\\blogs-app\\src\\component\\common\\notFound.js",[],"C:\\Users\\oussa\\Documents\\javascript\\NodeJs\\node-express\\Blog project\\blogs-app\\src\\component\\showBlog.js",["81"],"C:\\Users\\oussa\\Documents\\javascript\\NodeJs\\node-express\\Blog project\\blogs-app\\src\\redux\\reducers\\blogReducer.js",["82"],"import { GET_BLOGS } from \"../constant\";\r\nconst initialState = {\r\n    blogs : [],\r\n}\r\n\r\nconst BlogReducer = (state = initialState , action) => {\r\n    switch(action.type){\r\n        case 'GET_BLOGS' :\r\n            return {\r\n                ...state,\r\n                blogs : action.payload\r\n            }\r\n        default : \r\n            return initialState;\r\n    }\r\n}\r\n\r\nexport default BlogReducer;","C:\\Users\\oussa\\Documents\\javascript\\NodeJs\\node-express\\Blog project\\blogs-app\\src\\redux\\actions\\blogAction.js",["83"],"import { GET_BLOGS } from \"../constant\";\r\nimport axios from 'axios';\r\n\r\nexport const getBlogs = (data) => {\r\n    return {\r\n        type : 'GET_BLOGS',\r\n        payload : data,\r\n    }\r\n}\r\n\r\nexport const main = () => {\r\n    return async (dispatch) => { \r\n        return await axios.get('http://localhost:3000/blogs').then(\r\n            (res) => {\r\n                dispatch(getBlogs(res.data));\r\n            }\r\n        )\r\n        \r\n    }\r\n}","C:\\Users\\oussa\\Documents\\javascript\\NodeJs\\node-express\\Blog project\\blogs-app\\src\\redux\\constant.js",["84"],"const GET_BLOGS = 'GET_BLOGS';\r\nexport const SHOW_BLOGS = 'GET_BLOGS';","C:\\Users\\oussa\\Documents\\javascript\\NodeJs\\node-express\\Blog project\\blogs-app\\src\\assets\\svg\\triangle.js",[],"C:\\Users\\oussa\\Documents\\javascript\\NodeJs\\node-express\\Blog project\\blogs-app\\src\\redux\\actions\\showBlogAction.js",[],"C:\\Users\\oussa\\Documents\\javascript\\NodeJs\\node-express\\Blog project\\blogs-app\\src\\redux\\reducers\\showBlogReducer.js",[],{"ruleId":"85","replacedBy":"86"},{"ruleId":"87","re