\src\\partials\\nav.js",["58","59","60","61","62"],"import \"../styles/style.css\";\r\nimport blogtech from \"../assets/img/blogtech.png\";\r\n\r\nconst Nav = () => {\r\n  return (\r\n    <div className=\"nav\">\r\n      <div className=\"site-title\">\r\n        <a href=\"\">\r\n          <img className=\"navImg\" src={blogtech} />\r\n        </a>\r\n      </div>\r\n      <div className=\"navigation\">\r\n        <ul>\r\n          <li>\r\n            <a href=\"\">Blogs</a>\r\n          </li>\r\n          <li>\r\n            <a href=\"\">About</a>\r\n          </li>\r\n          <li>\r\n            <a href=\"\">New Blog</a>\r\n          </li>\r\n        </ul>\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default Nav;\r\n","C:\\Users\\oussa\\Documents\\NodeJs\\node-express\\blogs-app\\src\\component\\home.js",["63"],"\r\nimport Blog from './blog';\r\nimport Triangle from '../assets/svg/triangle';\r\nconst Home = () => {\r\n    return ( \r\n        <div className=\"home\">\r\n        <div className=\"HomeHeader\">\r\n            <div className=\"HomeHeaderChild1\">\r\n                <h1 className=\"blogName\">BlogTech</h1>\r\n                <div className=\"homeText\">\r\n                    <span>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor</span>\r\n                </div>\r\n            </div>\r\n            <div className=\"HomeHeaderChild2\">\r\n                <div className=\"HomeHeaderChild21\">\r\n                   {/* <Triangle className=\"TriangleShape\" /> */}\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <Blog />\r\n        </div>\r\n     );\r\n}\r\n \r\nexport default Home;","C:\\Users\\oussa\\Documents\\NodeJs\\node-express\\blogs-app\\src\\component\\blog.js",["64","65"],"C:\\Users\\oussa\\Documents\\NodeJs\\node-express\\blogs-app\\src\\assets\\svg\\triangle.js",[],"C:\\Users\\oussa\\Documents\\NodeJs\\node-express\\blogs-app\\src\\redux\\store.js",[],"C:\\Users\\oussa\\Documents\\NodeJs\\node-express\\blogs-app\\src\\redux\\reducers\\blogReducer.js",["66"],"import { GET_BLOGS } from \"../constant\";\r\nconst initialState = {\r\n    blogs : [],\r\n}\r\n\r\nconst BlogReducer = (state = initialState , action) => {\r\n    switch(action.type){\r\n        case 'GET_BLOGS' :\r\n            return {\r\n                ...state,\r\n                blogs : action.payload\r\n            }\r\n        default : \r\n            return initialState;\r\n    }\r\n}\r\n\r\nexport default BlogReducer;","C:\\Users\\oussa\\Documents\\NodeJs\\node-express\\blogs-app\\src\\redux\\constant.js",["67"],"const GET_BLOGS = 'GET_BLOGS';","C:\\Users\\oussa\\Documents\\NodeJs\\node-express\\blogs-app\\src\\redux\\actions\\blogAction.js",["68"],"import { GET_BLOGS } from \"../constant\";\r\nimport axios from 'axios';\r\n\r\nexport const getBlogs = (data) => {\r\n    return {\r\n        type : 'GET_BLOGS',\r\n        payload : data,\r\n    }\r\n}\r\n\r\nexport const main = () => {\r\n    return async (dispatch) => { \r\n        return await axios.get('http://localhost:3000/blogs').then(\r\n            (res) => {\r\n                dispatch(getBlogs(res.data));\r\n            }\r\n        )\r\n        \r\n    }\r\n}","C:\\Users\\oussa\\Documents\\NodeJs\\node-express\\blogs-app\\src\\redux\\reducers\\rootReducer.js",[],{"ruleId":"69","replacedBy":"70"},{"ruleId":"71","replacedBy":"72"},{"ruleId":"73","severity":1,"message":"74","line":8,"column":9,"nodeType":"75","endLine":8,"endColumn":20},{"ruleId":"76","severity":1,"message":"77","line":9,"column":11,"nodeType":"75","endLine":9,"endColumn":52},{"ruleId":"73","severity":1,"message":"74","line":15,"column":13,"nodeType":"75","endLine":15,"endColumn":24},{"ruleId":"73","severity":1,"message":"74","line":18,"column":13,"nodeType":"75","endLine":18,"endColumn":24},{"ruleId":"73","severity":1,"message":"74","line":21,"column":13,"nodeType":"75","endLine":21,"endColumn":24},{"ruleId":"78","severity":1,"message":"79","line