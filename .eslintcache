log from './blog';\r\nimport Triangle from '../assets/svg/triangle';\r\nconst Home = () => {\r\n    return ( \r\n        <div className=\"home\">\r\n        <div className=\"HomeHeader\">\r\n            <div className=\"HomeHeaderChild1\">\r\n                <h1 className=\"blogName\">BlogTech</h1>\r\n                <div className=\"homeText\">\r\n                    <span>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor</span>\r\n                </div>\r\n            </div>\r\n            <div className=\"HomeHeaderChild2\">\r\n                <div className=\"HomeHeaderChild21\">\r\n                   {/* <Triangle className=\"TriangleShape\" /> */}\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <Blog />\r\n        </div>\r\n     );\r\n}\r\n \r\nexport default Home;","C:\\Users\\Abdelhak\\Desktop\\blog node js\\blogs-app\\src\\partials\\nav.js",["72","73"],"import \"../styles/style.css\";\r\nimport blogtech from \"../assets/img/blogtech.png\";\r\nimport {A} from 'hookrouter';\r\n\r\nconst Nav = () => {\r\n  return (\r\n    <div className=\"nav\">\r\n      <div className=\"site-title\">\r\n        <a href=\"\">\r\n          <img className=\"navImg\" src={blogtech} />\r\n        </a>\r\n      </div>\r\n      <div className=\"navigation\">\r\n        <ul>\r\n          <li>\r\n            <A href=\"/blog\">Blogs</A>\r\n          </li>\r\n          <li>\r\n            <A href=\"/about\">About</A>\r\n          </li>\r\n          <li>\r\n            <A href=\"\">New Blog</A>\r\n          </li>\r\n        </ul>\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default Nav;\r\n","C:\\Users\\Abdelhak\\Desktop\\blog node js\\blogs-app\\src\\redux\\constant.js",["74"],"const GET_BLOGS = 'GET_BLOGS';","C:\\Users\\Abdelhak\\Desktop\\blog node js\\blogs-app\\src\\component\\blog.js",["75","76"],"import '../styles/style.css';\r\nimport { useDispatch, useSelector } from 'react-redux'\r\nimport { useEffect } from 'react';\r\nimport { main } from '../redux/actions/blogAction';\r\n\r\nconst Blog = () => {\r\n  const dispatch = useDispatch()\r\n  useEffect(()=>{\r\n    dispatch(main());\r\n  },[]);\r\n  const blogs = useSelector((state) => state.Blog.blogs);\r\n  return (\r\n    <>\r\n    <div className=\"content\">\r\n    {(blogs && blogs.length > 0) &&\r\n      blogs.map((blog)=>{\r\n        return(\r\n          <div className=\"blogShape\">\r\n            <div className=\"single\">\r\n              <a  href=\"\">\r\n                <div className=\"blogContentDisplay\">\r\n                  <div className=\"blogImage\"></div>\r\n                  <div className=\"blogDescription\">\r\n                    <h3 className=\"title\">{blog.title}</h3>\r\n                    <p className=\"snippet\">\r\n                      {blog.snippet}\r\n                    </p>\r\n                  </div>\r\n                </div>\r\n              </a>\r\n            </div>\r\n          </div>\r\n        )\r\n      })\r\n    }\r\n    </div>\r\n    </>\r\n  );\r\n};\r\n\r\nexport default Blog;\r\n","C:\\Users\\Abdelhak\\Desktop\\blog node js\\blogs-app\\src\\assets\\svg\\triangle.js",[],"C:\\Users\\Abdelhak\\Desktop\\blog node js\\blogs-app\\src\\redux\\actions\\blogAction.js",["77"],"import { GET_BLOGS } from \"../constant\";\r\nimport axios from 'axios';\r\n\r\nexport const getBlogs = (data) => {\r\n    return {\r\n        type : 'GET_BLOGS',\r\n        payload : data,\r\n    }\r\n}\r\n\r\nexport const main = () => {\r\n    return async (dispatch) => { \r\n        return await axios.get('http://localhost:3000/blogs').then(\r\n            (res) => {\r\n                dispatch(getBlogs(res.data));\r\n            }\r\n        )\r\n        \r\n    }\r\n}","C:\\Users\\Abdelhak\\Desktop\\blog node js\\blogs-app\\src\\component\\showBlog.js",["78","79"],"// import '../styles/style.css';\r\nimport { useDispatch, useSelector } from 'react-redux'\r\nimport { useEffect } from 'react';\r\n\r\nconst Sho